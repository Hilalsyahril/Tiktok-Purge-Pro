{
  "manifest_version": 3,
  "name": "TikTok Purge Pro",
  "version": "3.4.2",
  "description": "Automated TikTok profile cleanup tool.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"]
    }
  ]
}
